# Copy this file to .env  (Windows: copy .env.example .env)
# LAPTOP: keep the lines below as they are -> SQLite file + photos in a local folder.
# AWS EC2: the server writes its own .env (see the setup prompt) with the AWS lines.

SECRET_KEY=change-this-to-any-long-random-text

# ---- Laptop ----
PORT=5001
DATABASE_URL=sqlite:///foundit.db
DYNAMODB_TABLE=
S3_BUCKET=

# ---- AWS (EC2) ----
# DYNAMODB_TABLE=foundit-reports
# S3_BUCKET=foundit-photos-24bce1890
# AWS_REGION=ap-south-1
